# ===================================================================
# TazaTokri Production Environment Variables Template (.env.example)
# Copy this file to .env and fill in secure values before deploying.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ===================================================================

# --- MySQL Database Configuration ---
DB_NAME=tazatokri
DB_APP_USER=tazatokri_app
# Choose a strong random password (e.g. openssl rand -base64 24)
DB_APP_PASSWORD=PLACEHOLDER_SECURE_APP_DB_PASSWORD
DB_ROOT_PASSWORD=PLACEHOLDER_SECURE_ROOT_DB_PASSWORD

# --- JWT Authentication ---
# MUST be at least 32 characters (256 bits) for HMAC-SHA256
# Generate with: openssl rand -base64 32
JWT_SECRET=PLACEHOLDER_STRONG_JWT_SECRET_MIN_32_CHARS_LONG

# --- Owner Bootstrap (Used ONLY when no owner account exists on first run) ---
BOOTSTRAP_OWNER_NAME=TazaTokri Store Owner
BOOTSTRAP_OWNER_PHONE=9999999999
BOOTSTRAP_OWNER_PASSWORD=PLACEHOLDER_SECURE_BOOTSTRAP_OWNER_PASSWORD

# --- CORS & Networking ---
# Comma-separated list of allowed origins (e.g., https://tazatokri.com)
CORS_ALLOWED_ORIGINS=https://your-production-domain.com

# --- Frontend Build ---
# Base API URL (omit or leave empty for same-origin reverse-proxy deployment)
VITE_API_URL=

# --- Razorpay Payment Gateway (Optional; required for online payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- WhatsApp Cloud API (Optional Stage 2) ---
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Google Gemini AI (Optional Phase 3) ---
GEMINI_ENABLED=false
GEMINI_API_KEY=

# --- Deployment Version ---
APP_VERSION=0.4.0

# --- Storage & Backups ---
STORAGE_PROVIDER=LOCAL
# Host path for backup status metadata (mounted :ro into backend at /app/data/backup-status/backup-status.json)
BACKUP_STATUS_FILE=./backend/data/backup-status/backup-status.json
# Required for production backups (AES-256-CBC PBKDF2); keep independent from server!
BACKUP_ENCRYPTION_PASSPHRASE=PLACEHOLDER_STRONG_BACKUP_PASSPHRASE
BACKUP_RETENTION_DAYS=14
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
